# Local XAMPP settings (defaults match config/database.php).
# For Alwaysdata deployment, copy .htaccess.alwaysdata.example to .htaccess on the server.

SetEnv RENTAL_DB_HOST "localhost"
SetEnv RENTAL_DB_USER "root"
SetEnv RENTAL_DB_PASSWORD ""
SetEnv RENTAL_DB_NAME "rental_db"
SetEnv RENTAL_BASE_URL "/Rental/"
SetEnv RENTAL_ADMIN_PASSWORD "change-this-password"